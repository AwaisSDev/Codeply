{
  "rewrites": [
    { "source": "/download", "destination": "/download.html" },
    { "source": "/changelog", "destination": "/changelog.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/careers", "destination": "/careers.html" },
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/codeply", "destination": "/codeply.html" },
    { "source": "/cli", "destination": "/cli.html" },
    { "source": "/wisp", "destination": "/wisp.html" },
    { "source": "/crew", "destination": "/wisp.html" },
    { "source": "/apps", "destination": "/apps.html" },
    { "source": "/specialists", "destination": "/specialists.html" },
    { "source": "/voice", "destination": "/voice.html" },
    { "source": "/mobile", "destination": "/mobile.html" },
    { "source": "/chat", "destination": "/chat.html" },
    { "source": "/chat/", "destination": "/chat.html" },
    { "source": "/chat/:id([0-9a-z]{6,40})", "destination": "/chat.html" }
  ],
  "cleanUrls": true,
  "routes": [
    { "src": "/craft(?:\\.html)?/?", "status": 308, "headers": {"Location": "/codeply"} },
    { "src": "/drop(?:\\.html)?/?", "status": 308, "headers": {"Location": "/codeply"} },
    { "handle": "filesystem" },
    { "src": "/.*", "status": 404, "dest": "/404.html" }
  ]
}
